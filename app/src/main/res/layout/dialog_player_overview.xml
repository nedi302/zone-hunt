<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overviewOutTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/overview_found_title"
                android:textAppearance="@style/TextAppearance.Zonenjagd.Section"
                android:textColor="@color/red" />

            <TextView
                android:id="@+id/overviewOutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/overview_empty"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/overviewOutList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/overviewAliveTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/overview_alive_title"
                android:textAppearance="@style/TextAppearance.Zonenjagd.Section"
                android:textColor="@color/mint" />

            <LinearLayout
                android:id="@+id/overviewAliveList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/overview_note"
        android:textColor="@color/muted"
        android:textSize="10sp" />
</LinearLayout>
